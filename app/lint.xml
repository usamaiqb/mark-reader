<?xml version="1.0" encoding="UTF-8"?>
<!--
  Android Lint policy.

  CI runs `./gradlew lint` on every pull request and the job fails on lint *errors*.
  Warnings are deliberately left as warnings for now; turning on `warningsAsErrors` is
  planned.

  Anything suppressed here needs a reason next to it.
-->
<lint>
    <!-- Fires on Compose-held state that never touches LiveData nullability. -->
    <issue id="NullSafeMutableLiveData" severity="ignore" />

    <!--
      Translations are contributed by the community in separate PRs, so a feature PR may add
      strings ahead of their translations. Android falls back to the default (en) string at
      runtime, so an incomplete locale is a warning rather than a build-failing error.
      ExtraTranslation stays an error: a translation of a string that no longer exists is stale,
      and is deleted along with the string.
    -->
    <issue id="MissingTranslation" severity="warning" />
</lint>
